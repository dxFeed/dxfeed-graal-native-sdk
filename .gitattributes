# Shell scripts must keep LF line endings to run on Linux/macOS/WSL, even when checked out on Windows.
*.sh text eol=lf

# Patches are applied with git apply on macOS, their context lines must keep LF line endings.
*.patch text eol=lf

# The pinned SSH host keys of github.com are read by ssh on the Linux agents.
.teamcity/github_known_hosts text eol=lf
