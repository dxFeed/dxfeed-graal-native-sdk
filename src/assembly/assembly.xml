<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.1 http://maven.apache.org/xsd/assembly-2.1.1.xsd">
  <id>${arch.name}${static.suffix}${debug.suffix}</id>
  <formats>
    <format>zip</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>
  <!-- The CMake file (cmake.xml; no-cmake.xml for iOS, see assembly.cmake.component in the pom). -->
  <componentDescriptors>
    <componentDescriptor>${assembly.cmake.component}</componentDescriptor>
  </componentDescriptors>
  <fileSets>
    <fileSet>
      <directory>${native.image.path}</directory>
      <includes>
        <!--
          Only the files of the image: .dll, .lib, .pdb, .so, .so.debug (Linux debug builds, see .gnu_debuglink of
          the .so), .dylib, .o (iOS). native-image also copies next to the image the JDK libraries that the reachable
          code loads with System.loadLibrary (management_ext, osxkrb5 on macOS), which the SDK does not need:
          management_ext cannot even be loaded without the java and jvm libraries of a JDK.
        -->
        <include>${native.image.name}.*</include>
        <include>*.h</include>
        <!-- iOS: the JDK and Substrate VM libraries of jre-ios. -->
        <include>*.a</include>
        <!-- Debug builds: the gdb helpers. -->
        <include>gdb-debughelpers.py</include>
      </includes>
      <excludes>
        <exclude>${native.image.name}.h</exclude>
        <exclude>${native.image.name}_dynamic.h</exclude>
      </excludes>
      <outputDirectory/>
    </fileSet>
    <fileSet>
      <directory>${native.image.path}/reports</directory>
      <includes>
        <include>*.txt</include>
      </includes>
      <outputDirectory>docs</outputDirectory>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/src/main/c/api</directory>
      <excludes>
        <exclude>.idea/**</exclude>
        <exclude>cmake-**/**</exclude>
        <exclude>*.txt</exclude>
      </excludes>
      <outputDirectory/>
    </fileSet>
    <fileSet>
      <directory>${project.build.directory}/docs</directory>
      <includes>
        <include>changelog.txt</include>
        <include>${project.name}-version.inc</include>
      </includes>
      <outputDirectory>docs</outputDirectory>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}</directory>
      <includes>
        <include>LICENSE</include>
      </includes>
      <outputDirectory/>
    </fileSet>
  </fileSets>
</assembly>
