#ifdef __MINGW32__
#include <winresrc.h>
#else
#include "winres.h"
#endif

#define xstr(s) str(s)
#define str(s) #s

// DXFSDK_PRE_RELEASE is 1 for a version with a qualifier (3.6.0-rc2, 3.10.1-SNAPSHOT) and 0 for a release.
#if DXFSDK_PRE_RELEASE
#define DXFSDK_PRE_RELEASE_FLAG VS_FF_PRERELEASE
#else
#define DXFSDK_PRE_RELEASE_FLAG 0x0L
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DXFSDK_MAJOR_VERSION, DXFSDK_MINOR_VERSION, DXFSDK_PATCH_VERSION, DXFSDK_PRE_RELEASE_NUMBER
 PRODUCTVERSION DXFSDK_MAJOR_VERSION, DXFSDK_MINOR_VERSION, DXFSDK_PATCH_VERSION, DXFSDK_PRE_RELEASE_NUMBER
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG | DXFSDK_PRE_RELEASE_FLAG
#else
 FILEFLAGS DXFSDK_PRE_RELEASE_FLAG
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Devexperts LLC"
            VALUE "FileDescription", "GraalVM C-library wrapper for dxFeed Java API."
            // .NET FileVersionInfo (PowerShell VersionInfo) ignores the whole string block without FileVersion.
            VALUE "FileVersion", xstr(DXFSDK_VERSION)
            VALUE "InternalName", "DxFeedGraalNativeSdk.dll"
            VALUE "LegalCopyright", xstr(Copyright (C) DXFSDK_YEAR Devexperts LLC)
            VALUE "OriginalFilename", "DxFeedGraalNativeSdk.dll"
            VALUE "ProductName", "dxFeed Graal Native SDK"
            VALUE "ProductVersion", xstr(DXFSDK_VERSION)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
