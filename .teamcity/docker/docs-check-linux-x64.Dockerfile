#
# Dockerfile for checking the C API documentation on Linux
#
# This Dockerfile creates an environment for the step "Check the C API documentation" of the build "Test [Linux, x64]":
# Doxygen runs with docs/Doxyfile.check over the headers of src/main/c/api and reports the undocumented declarations,
# parameters and return values and the broken references.
# Doxygen is the official release binary: the versions before 1.13 report every function as having undocumented
# parameters (WARN_NO_PARAMDOC), and the binaries of 1.11 and later need glibc 2.34 and the libstdc++ of GCC 12,
# which neither Oracle Linux 7 (the build image) nor Oracle Linux 9 (the test image) has.
# The release documentation is still generated by the Doxygen of the build image (graalvm-linux-x64.Dockerfile).
#
# Tools: Doxygen (/usr/local/bin/doxygen), Bash, grep.
#
# BUILD
#
# Run from .teamcity (the build context); the version and the SHA-256 of the release archive are in Common.kt (Doxygen).
# docker build --pull --build-arg DOXYGEN_VERSION=<version> --build-arg DOXYGEN_SHA256=<sha256> -t <name:tag> -f docker/docs-check-linux-x64.Dockerfile .
#
# RUN
#
# docker run --rm -v "$(pwd):/mnt" <name:tag> "mkdir -p target/c-api-docs-check && doxygen docs/Doxyfile.check"
#

FROM ubuntu:24.04

ARG DOXYGEN_VERSION
ARG DOXYGEN_SHA256

RUN if [ -z "${DOXYGEN_VERSION}" ] || [ -z "${DOXYGEN_SHA256}" ]; then \
        echo "Pass DOXYGEN_VERSION and DOXYGEN_SHA256 with --build-arg" >&2; exit 1; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    archive="doxygen-${DOXYGEN_VERSION}.linux.bin.tar.gz" && \
    curl --fail --location --silent --show-error --output "/tmp/${archive}" \
        "https://github.com/doxygen/doxygen/releases/download/Release_$(echo "${DOXYGEN_VERSION}" | tr . _)/${archive}" && \
    echo "${DOXYGEN_SHA256}  /tmp/${archive}" | sha256sum --check --strict && \
    tar -xzf "/tmp/${archive}" -C /usr/local/bin --strip-components=2 "doxygen-${DOXYGEN_VERSION}/bin/doxygen" && \
    rm "/tmp/${archive}" && \
    apt-get purge -y --auto-remove ca-certificates curl && \
    rm -rf /var/lib/apt/lists/* && \
    doxygen --version

ENTRYPOINT ["/bin/bash", "-lc"]

WORKDIR /mnt/
