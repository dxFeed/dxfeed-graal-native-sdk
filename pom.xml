  <profiles>
    <!--
      GraalVM 25.4 moved some SVM internals (e.g. @Uninterruptible) from svm.jar to svm-shared.jar
      and does not publish these jars to Maven Central, so they are taken from the GraalVM that runs the build.
      Exactly one of the svm-shared and svm-core profiles is activated, depending on the GraalVM layout.
    -->
    <profile>
      <id>svm-shared</id>
      <activation>
        <file>
          <exists>${java.home}/lib/svm/builder/svm-shared.jar</exists>
        </file>
      </activation>
      <properties>
        <svm.sources>src/main/java-svm-shared</svm.sources>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.graalvm.nativeimage</groupId>
          <artifactId>svm</artifactId>
          <version>${graalvm.version}</version>
          <scope>system</scope>
          <systemPath>${java.home}/lib/svm/builder/svm.jar</systemPath>
        </dependency>
        <dependency>
          <groupId>org.graalvm.nativeimage</groupId>
          <artifactId>svm-shared</artifactId>
          <version>${graalvm.version}</version>
          <scope>system</scope>
          <systemPath>${java.home}/lib/svm/builder/svm-shared.jar</systemPath>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>svm-core</id>
      <activation>
        <file>
          <missing>${java.home}/lib/svm/builder/svm-shared.jar</missing>
        </file>
      </activation>
      <properties>
        <svm.sources>src/main/java-svm-core</svm.sources>
        <!-- The reachability metadata of newer plugin versions is not supported by older GraalVM versions. -->
        <graalvm-native-maven-plugin.version>0.10.6</graalvm-native-maven-plugin.version>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.graalvm.nativeimage</groupId>
          <artifactId>svm</artifactId>
          <version>${svm-core.version}</version>
          <scope>provided</scope>
        </dependency>
      </dependencies>
    </profile>
    <!--
      Generates the C API documentation with Doxygen (docs/Doxyfile, doxygen must be in PATH)
      and attaches it as the c-api-docs-html zip, so it is deployed with the other artifacts.
      Activation: -Dc-api-docs
    -->
    <profile>
      <id>c-api-docs</id>
      <activation>
        <property>
          <name>c-api-docs</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>generate-c-api-docs</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>doxygen</executable>
                  <workingDirectory>${project.basedir}</workingDirectory>
                  <arguments>
                    <argument>docs/Doxyfile</argument>
                  </arguments>
                  <environmentVariables>
                    <DXFG_DOCS_VERSION>${project.version}</DXFG_DOCS_VERSION>
                    <DXFG_DOCS_OUTPUT>${project.build.directory}/docs/c-api</DXFG_DOCS_OUTPUT>
                  </environmentVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-assembly-plugin</artifactId>
            <executions>
              <execution>
                <id>c-api-docs</id>
                <phase>package</phase>
                <goals>
                  <goal>single</goal>
                </goals>
                <configuration>
                  <finalName>${project.name}</finalName>
                  <descriptors>
                    <descriptor>src/assembly/c-api-docs.xml</descriptor>
                  </descriptors>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
