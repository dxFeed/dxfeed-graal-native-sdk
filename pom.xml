    <profile>
      <id>windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <native.image.name>DxFeedGraalNativeSdk</native.image.name>
      </properties>
      <dependencies>
        <dependency>
          <groupId>com.devexperts.mdd</groupId>
          <artifactId>auther-api</artifactId>
          <version>${auther-api.version}</version>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>parse-version</id>
                <phase>initialize</phase>
                <goals>
                  <goal>parse-version</goal>
                </goals>
                <configuration>
                  <propertyPrefix>parsedVersion</propertyPrefix>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.3.0</version>
            <executions>
              <execution>
                <id>build-version-res</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>compile</phase>
                <configuration>
                  <executable>rc</executable>
                  <workingDirectory>${project.basedir}</workingDirectory>
                  <arguments>
                    <argument>-DDXFSDK_VERSION=${project.version}</argument>
                    <!--suppress UnresolvedMavenProperty -->
                    <argument>-DDXFSDK_MAJOR_VERSION=${parsedVersion.majorVersion}</argument>
                    <!--suppress UnresolvedMavenProperty -->
                    <argument>-DDXFSDK_MINOR_VERSION=${parsedVersion.minorVersion}</argument>
                    <!--suppress UnresolvedMavenProperty -->
                    <argument>-DDXFSDK_PATCH_VERSION=${parsedVersion.incrementalVersion}</argument>
                    <argument>version.rc</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>${graalvm-native-maven-plugin.version}</version>
            <extensions>true</extensions>
            <executions>
              <execution>
                <id>build-native</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
            <configuration>
              <metadataRepository>
                <enabled>true</enabled>
              </metadataRepository>
              <skip>false</skip>
              <imageName>${native.image.name}</imageName>
              <sharedLibrary>${isShared}</sharedLibrary>
              <buildArgs>
                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                <buildArg>--enable-url-protocols=http,https</buildArg>
                <buildArg>--enable-monitoring=jmxserver,jmxclient,jvmstat</buildArg>
                <buildArg>-H:Name=${native.image.name}</buildArg>
                <buildArg>-Dproject.path=${project.basedir}</buildArg>
                <buildArg>-H:CLibraryPath=${project.basedir}/</buildArg>
                <buildArg>-H:Path=${native.image.path}</buildArg>
                <buildArg>--add-exports=org.graalvm.nativeimage.builder/com.oracle.svm.core=ALL-UNNAMED</buildArg>
                <buildArg>--add-exports=org.graalvm.nativeimage.builder/com.oracle.svm.core.jni=ALL-UNNAMED</buildArg>
                <buildArg>
                  --initialize-at-build-time=${initialize-at-build-time}
                </buildArg>
                <buildArg>-march=compatibility</buildArg>
                <buildArg>-H:NativeLinkerOption=version.res</buildArg>
                <buildArg>${debug.buildArg1}</buildArg>
                <buildArg>${debug.buildArg2}</buildArg>
<!--                <buildArg>${debug.buildArg3}</buildArg>-->
              </buildArgs>
              <debug>${isDebug}</debug>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
