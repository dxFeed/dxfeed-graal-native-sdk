<Project>
    <!-- Packed as build/net461/<package id>.targets: MSBuildThisFileName is the package id. -->
    <Import Project="$(MSBuildThisFileDirectory)..\..\buildTransitive\net461\$(MSBuildThisFileName).targets" Condition="!$([System.String]::Copy(';$(DxFeedGraalNativePackages);').Contains(';$(MSBuildThisFileName);'))" />
</Project>
