<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <id>DxFeed.Graal.Native</id>
        <version>$version$</version>
        <description>The native libraries of the dxFeed Graal Native SDK: the dxFeed Java API compiled with GraalVM Native Image into a shared library with a C API, for Windows, Linux and macOS. Used by DxFeed.Graal.Net.</description>
        <authors>dxFeed API Team</authors>
        <copyright>Copyright © 2022 Devexperts LLC</copyright>
        <license type="expression">MPL-2.0</license>
        <licenseUrl>https://licenses.nuget.org/MPL-2.0</licenseUrl>
        <icon>docs/images/favicon.png</icon>
        <readme>docs/README.md</readme>
        <projectUrl>https://github.com/dxFeed/dxfeed-graal-native-sdk</projectUrl>
        <repository type="git" url="https://github.com/dxFeed/dxfeed-graal-native-sdk.git" />
        <tags>api, market data, dxfeed, graalvm</tags>
        <dependencies>
            <group targetFramework="netstandard2.0" />
        </dependencies>
    </metadata>
    <files>
        <file src="docs/images/favicon.png" target="docs/images/favicon.png" />
        <file src="docs/README.md" target="docs/README.md" />
        <file src="runtimes/**"  target="runtimes"/>
        <file src="buildTransitive/net461/DxFeed.Graal.Native.targets" target="buildTransitive/net461/DxFeed.Graal.Native.targets" />
        <file src="build/net461/DxFeed.Graal.Native.targets" target="build/net461/DxFeed.Graal.Native.targets" />
        <file src="build/net461/DxFeed.Graal.Native.props" target="build/net461/DxFeed.Graal.Native.props" />
        <file src="lib/netstandard2.0/_._" target="lib/netstandard2.0/_._" />
    </files>
</package>
