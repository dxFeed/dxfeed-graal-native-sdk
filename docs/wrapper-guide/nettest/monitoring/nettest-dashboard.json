          "expr": "sum by (tool, name) (rate(nettest_e2e_lag_negative_total{name=~\"$name\",tool=~\"$tool\"}[$__rate_interval]))",
          "legendFormat": "{{tool}} {{name}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "nettest-prometheus"
          },
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Connector lag and round-trip time",
      "description": "Connector statistics v2 (QD's own time marks): the data read lag of the consumer and the round-trip time; no data without v2. The publisher's lag is not exported. Over the window $window: the tools update these counters once per statistics period.",
      "datasource": {
        "type": "prometheus",
        "uid": "nettest-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (tool, side, name) (rate(nettest_connector_lag_seconds_total{name=~\"$name\",tool=~\"$tool\"}[$window])) / sum by (tool, side, name) (rate(nettest_connector_read_records_total{name=~\"$name\",tool=~\"$tool\"}[$window]))",
          "legendFormat": "lag {{tool}} {{side}} {{name}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "nettest-prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "sum by (tool, side, name) (rate(nettest_connector_rtt_seconds_total{name=~\"$name\",tool=~\"$tool\"}[$window])) / (sum by (tool, side, name) (rate(nettest_connector_read_records_total{name=~\"$name\",tool=~\"$tool\"}[$window])) + sum by (tool, side, name) (rate(nettest_connector_written_records_total{name=~\"$name\",tool=~\"$tool\"}[$window])) + sum by (tool, side, name) (rate(nettest_connector_sub_records_total{name=~\"$name\",tool=~\"$tool\"}[$window])))",
          "legendFormat": "rtt {{tool}} {{side}} {{name}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "nettest-prometheus"
          },
          "refId": "B"
        }
      ]
    },
