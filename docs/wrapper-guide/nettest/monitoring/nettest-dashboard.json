          "calcs": [
            "lastNotNull",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (tool, name) (rate(nettest_e2e_lag_seconds_sum{name=~\"$name\",tool=~\"$tool\"}[$__rate_interval])) / sum by (tool, name) (rate(nettest_e2e_lag_seconds_count{name=~\"$name\",tool=~\"$tool\"}[$__rate_interval]))",
          "legendFormat": "{{tool}} {{name}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "nettest-prometheus"
          },
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Negative lags per second",
      "description": "A clock step or skew between the hosts; 0 on one host.",
      "datasource": {
        "type": "prometheus",
        "uid": "nettest-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
