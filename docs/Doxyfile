# Doxygen configuration of the C API documentation (only the values that differ from the defaults).
# Run from the project root (see the c-api-docs profile in pom.xml):
#   DXFG_DOCS_VERSION=<version> DXFG_DOCS_OUTPUT=<output dir> doxygen docs/Doxyfile

PROJECT_NAME           = "dxFeed Graal Native SDK"
PROJECT_NUMBER         = $(DXFG_DOCS_VERSION)
OUTPUT_DIRECTORY       = $(DXFG_DOCS_OUTPUT)
INPUT                  = src/main/c/api
FILE_PATTERNS          = *.h
FULL_PATH_NAMES        = NO
EXTRACT_ALL            = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
